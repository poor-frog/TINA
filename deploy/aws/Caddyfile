tinabot.duckdns.org {
    encode zstd gzip

    @extension {
        path /extension-api/auth/me
        path /extension-api/meetings
        path /extension-api/meetings/*
        path /extension-api/bots
        path /extension-api/bots/*
        path /extension-api/transcripts/*
        path /extension-api/agent/meeting-translations/*
    }

    handle @extension {
        uri strip_prefix /extension-api
        reverse_proxy 127.0.0.1:18056
    }

    @extensionKnowledge path_regexp extensionKnowledge "^/extension-api/agent/workspace/meeting-knowledge/[1-9][0-9]*(/ask|/facts/review|/answers/[a-f0-9]{32}/apply)?$"
    handle @extensionKnowledge {
        uri strip_prefix /extension-api
        reverse_proxy 127.0.0.1:18056
    }

    handle {
        reverse_proxy 127.0.0.1:13000
    }
}
