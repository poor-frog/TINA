  "actions_block": "<!--$$-->\n<table\n  align=\"center\"\n  width=\"100%\"\n  border=\"0\"\n  cellpadding=\"0\"\n  cellspacing=\"0\"\n  role=\"presentation\"\n  style=\"margin:16px 0 0;background-color:#F7F8F3;border:1px solid #D3DED5;border-radius:10px\">\n  <tbody>\n    <tr>\n      <td style=\"padding:14px 16px\">\n        <p\n          style=\"font-size:12px;line-height:18px;margin:0 0 8px;font-weight:700;letter-spacing:0.5px;color:#176B5B;text-transform:uppercase;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0\">\n          Việc cần làm\n        </p>\n        <ul style=\"margin:0;padding-left:18px;color:#173B36\">\n          $items\n        </ul>\n      </td>\n    </tr>\n  </tbody>\n</table>\n<!--/$$-->\n",
  "overview_section": "<!--$$-->\n<table\n  align=\"center\"\n  width=\"100%\"\n  border=\"0\"\n  cellpadding=\"0\"\n  cellspacing=\"0\"\n  role=\"presentation\">\n  <tbody>\n    <tr>\n      <td>\n        <hr\n          style=\"width:100%;border:none;border-color:transparent;border-top:1px solid #D3DED5;margin:24px 0\" />\n        <h2\n          style=\"margin:0 0 14px;font-size:16px;line-height:24px;font-weight:700;color:#173B36\">\n          Tổng quan cuộc họp\n        </h2>\n        <ul style=\"margin:0;padding-left:18px;color:#173B36\">\n          $items\n        </ul>\n        $actions\n        <table\n          role=\"presentation\"\n          width=\"100%\"\n          cellpadding=\"0\"\n          cellspacing=\"0\"\n          border=\"0\"\n          style=\"margin-top:22px\">\n          <tbody>\n            <tr>\n              <td align=\"center\">\n                <a\n                  href=\"$url\"\n                  class=\"box-border\"\n                  style=\"line-height:20px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;box-sizing:border-box;text-align:center;background-color:#176B5B;color:#FFFFFF;border:1px solid #176B5B;border-radius:8px;padding:13px 26px;font-size:14px;font-weight:600;padding-top:13px;padding-right:26px;padding-bottom:13px;padding-left:26px\"\n                  target=\"_blank\"\n                  ><span\n                    ><!--[if mso]><i style=\"mso-font-width:433.3333333333333%;mso-text-raise:19.5px\" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span\n                  ><span\n                    style=\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9.75px\"\n                    >Xem toàn bộ ghi chú cuộc họp</span\n                  ><span\n                    ><!--[if mso]><i style=\"mso-font-width:433.3333333333333%\" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span\n                  ></a\n                >\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </td>\n    </tr>\n  </tbody>\n</table>\n<!--/$$-->\n"
