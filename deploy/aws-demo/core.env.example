# Store ACTUAL values in AWS Systems Manager Parameter Store SecureString:
# /tina/demo/core-env  (do not commit live secrets to GitHub)
COMPOSE_PROJECT_NAME=tina-v012
COMPOSE_PROFILES=
TINA_COMPOSE_ENV_FILE=/opt/tina/secrets/core.env
IMAGE_TAG=demo
DB_NAME=tina
DB_USER=tina
DB_PASSWORD=REPLACE_RANDOM_HEX
ADMIN_TOKEN=REPLACE_RANDOM_HEX
INTERNAL_API_SECRET=REPLACE_RANDOM_HEX
TINA_DISPATCH_SIGNING_KEY=REPLACE_RANDOM_HEX
NEXTAUTH_SECRET=REPLACE_RANDOM_HEX
MINIO_ACCESS_KEY=tina-demo-access
MINIO_SECRET_KEY=REPLACE_RANDOM_HEX
MINIO_BUCKET=tina
TINA_FLOWS_API_KEY=REPLACE_RANDOM_HEX
TINA_FLOWS_ADMIN_KEY=REPLACE_RANDOM_HEX
TINA_UI_URL=https://tinabot.duckdns.org
NEXTAUTH_URL=https://tinabot.duckdns.org
TINA_TERMINAL_URL=https://tinabot.duckdns.org
# Replace with REAL private IPv4 of speech EC2, e.g. 10.20.2.X
TRANSCRIPTION_SERVICE_URL=http://10.20.2.X:18002
TRANSCRIPTION_SERVICE_TOKEN=REPLACE_SAME_LONG_TOKEN_AS_SPEECH
TRANSCRIPTION_MODEL=5CD-AI/VieGem-ASR
BROWSER_IMAGE=ghcr.io/poor-frog/tina-bot:demo
AGENT_IMAGE=ghcr.io/poor-frog/tina-agent-api:demo
AGENT_WORKER_IMAGE=ghcr.io/poor-frog/tina-agent-worker:demo
# Required for real Google sign-in; set matching Google Cloud OAuth callback URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional externally configured model API credentials for agent/translation:
ANTHROPIC_API_KEY=
TINA_AGENT_MODEL=
TINA_MEETING_MODEL=
