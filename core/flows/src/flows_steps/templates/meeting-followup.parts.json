{
  "paragraph": "<!--$$-->\n<p\n  style=\"font-size:14px;line-height:23px;color:#526860;margin:0 0 14px;margin-top:0;margin-right:0;margin-bottom:14px;margin-left:0\">\n  $text\n</p>\n<!--/$$-->\n",
  "notice": "<!--$$-->\n<p\n  style=\"font-size:12px;line-height:19px;color:#526860;margin:0 0 18px;text-align:center;margin-top:0;margin-right:0;margin-bottom:18px;margin-left:0\">\n  $text\n</p>\n<!--/$$-->\n",
  "summary": "<!--$$-->\n<table\n  align=\"center\"\n  width=\"100%\"\n  border=\"0\"\n  cellpadding=\"0\"\n  cellspacing=\"0\"\n  role=\"presentation\"\n  style=\"margin-bottom:12px\">\n  <tbody>\n    <tr>\n      <td>\n        <a\n          href=\"$url\"\n          class=\"box-border\"\n          style=\"line-height:20px;text-decoration:none;display:block;max-width:100%;mso-padding-alt:0px;box-sizing:border-box;text-align:center;background-color:#176B5B;color:#FFFFFF;border:1px solid #176B5B;border-radius:8px;padding:14px 18px;font-size:14px;font-weight:600;padding-top:14px;padding-right:18px;padding-bottom:14px;padding-left:18px\"\n          target=\"_blank\"\n          ><span\n            ><!--[if mso]><i style=\"mso-font-width:450%;mso-text-raise:21px\" hidden>&#8202;&#8202;</i><![endif]--></span\n          ><span\n            style=\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:10.5px\"\n            >Xem tóm tắt</span\n          ><span\n            ><!--[if mso]><i style=\"mso-font-width:450%\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span\n          ></a\n        >\n      </td>\n    </tr>\n  </tbody>\n</table>\n<!--/$$-->\n",
  "recording": "<!--$$-->\n<table\n  align=\"center\"\n  width=\"100%\"\n  border=\"0\"\n  cellpadding=\"0\"\n  cellspacing=\"0\"\n  role=\"presentation\"\n  style=\"margin-bottom:12px\">\n  <tbody>\n    <tr>\n      <td>\n        <a\n          href=\"$url\"\n          class=\"box-border\"\n          style=\"line-height:20px;text-decoration:none;display:block;max-width:100%;mso-padding-alt:0px;box-sizing:border-box;text-align:center;background-color:#FFFFFF;color:#176B5B;border:1px solid #D3DED5;border-radius:8px;padding:14px 18px;font-size:14px;font-weight:600;padding-top:14px;padding-right:18px;padding-bottom:14px;padding-left:18px\"\n          target=\"_blank\"\n          ><span\n            ><!--[if mso]><i style=\"mso-font-width:450%;mso-text-raise:21px\" hidden>&#8202;&#8202;</i><![endif]--></span\n          ><span\n            style=\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:10.5px\"\n            >Xem bản ghi</span\n          ><span\n            ><!--[if mso]><i style=\"mso-font-width:450%\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span\n          ></a\n        >\n      </td>\n    </tr>\n  </tbody>\n</table>\n<!--/$$-->\n",
  "organizer": "<!--$$-->\n<table\n  align=\"center\"\n  width=\"100%\"\n  border=\"0\"\n  cellpadding=\"0\"\n  cellspacing=\"0\"\n  role=\"presentation\"\n  style=\"margin:12px 0 0;text-align:center\">\n  <tbody>\n    <tr>\n      <td>\n        <p\n          style=\"font-size:13px;line-height:20px;margin:0;color:#526860;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">\n          Người tạo:<!-- -->\n          <strong style=\"color:#173B36;font-weight:700\">$name</strong>\n        </p>\n        <p\n          style=\"font-size:12px;line-height:18px;margin:2px 0 0;color:#526860;margin-top:2px;margin-right:0;margin-bottom:0;margin-left:0\">\n          $email\n        </p>\n      </td>\n    </tr>\n  </tbody>\n</table>\n<!--/$$-->\n",
  "organizer_email_only": "<!--$$-->\n<table\n  align=\"center\"\n  width=\"100%\"\n  border=\"0\"\n  cellpadding=\"0\"\n  cellspacing=\"0\"\n  role=\"presentation\"\n  style=\"margin:12px 0 0;text-align:center\">\n  <tbody>\n    <tr>\n      <td>\n        <p\n          style=\"font-size:13px;line-height:20px;margin:0;color:#526860;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">\n          Người tạo:<!-- -->\n          <strong style=\"color:#173B36;font-weight:700\">$email</strong>\n        </p>\n      </td>\n    </tr>\n  </tbody>\n</table>\n<!--/$$-->\n",
  "meeting_time": "<!--$$-->\n<p\n  style=\"font-size:13px;line-height:19px;margin:3px 0 0;color:#526860;margin-top:3px;margin-right:0;margin-bottom:0;margin-left:0\">\n  $text\n</p>\n<!--/$$-->\n",
  "stats_pair": "<!--$$-->\n<table\n  role=\"presentation\"\n  width=\"100%\"\n  cellpadding=\"0\"\n  cellspacing=\"0\"\n  border=\"0\"\n  style=\"margin-bottom:20px\">\n  <tbody>\n    <tr>\n      <td\n        width=\"48%\"\n        valign=\"middle\"\n        style=\"background-color:#F4EBCF;border:1px solid #E5D4A3;border-radius:10px;padding:14px 12px;text-align:center\">\n        <p\n          style=\"font-size:13px;line-height:19px;margin:0;font-weight:600;color:#62542B;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">\n          $left_text\n        </p>\n      </td>\n      <td width=\"4%\" style=\"font-size:1px;line-height:1px\"> </td>\n      <td\n        width=\"48%\"\n        valign=\"middle\"\n        style=\"background-color:#EAF1EC;border:1px solid #D3DED5;border-radius:10px;padding:14px 12px;text-align:center\">\n        <p\n          style=\"font-size:13px;line-height:19px;margin:0;font-weight:600;color:#176B5B;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">\n          $right_text\n        </p>\n      </td>\n    </tr>\n  </tbody>\n</table>\n<!--/$$-->\n",
  "stat_single": "<!--$$-->\n<table\n  role=\"presentation\"\n  width=\"100%\"\n  cellpadding=\"0\"\n  cellspacing=\"0\"\n  border=\"0\"\n  style=\"margin-bottom:20px\">\n  <tbody>\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tbody>\n            <tr>\n              <td\n                style=\"background-color:#EAF1EC;border:1px solid #D3DED5;border-radius:10px;padding:13px 22px;text-align:center\">\n                <p\n                  style=\"font-size:13px;line-height:19px;margin:0;font-weight:600;color:#176B5B;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\">\n                  $text\n                </p>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </td>\n    </tr>\n  </tbody>\n</table>\n<!--/$$-->\n",
  "topic_chip": "<!--$$--><span\n  style=\"display:inline-block;background-color:#F7F8F3;border:1px solid #D3DED5;border-radius:16px;padding:5px 12px;margin:3px 4px;font-size:12px;line-height:18px;font-weight:500;color:#173B36\"\n  >$text</span\n><!--/$$-->\n",
  "topics_block": "<!--$$-->\n<table\n  align=\"center\"\n  width=\"100%\"\n  border=\"0\"\n  cellpadding=\"0\"\n  cellspacing=\"0\"\n  role=\"presentation\"\n  style=\"margin-bottom:18px;text-align:center\">\n  <tbody>\n    <tr>\n      <td>\n        <p\n          style=\"font-size:11px;line-height:16px;margin:0 0 10px;font-weight:700;letter-spacing:0.8px;color:#526860;text-transform:uppercase;margin-top:0;margin-right:0;margin-bottom:10px;margin-left:0\">\n          Chủ đề thảo luận trong cuộc họp\n        </p>\n        <div style=\"text-align:center;line-height:30px\">$chips</div>\n      </td>\n    </tr>\n  </tbody>\n</table>\n<!--/$$-->\n",
  "insights_section": "<!--$$-->\n<table\n  align=\"center\"\n  width=\"100%\"\n  border=\"0\"\n  cellpadding=\"0\"\n  cellspacing=\"0\"\n  role=\"presentation\">\n  <tbody>\n    <tr>\n      <td>\n        <hr\n          style=\"width:100%;border:none;border-color:transparent;border-top:1px solid #D3DED5;margin:24px 0\" />\n        <p\n          style=\"font-size:15px;line-height:22px;margin:0 0 16px;font-weight:700;color:#173B36;text-align:center;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0\">\n          Trong cuộc họp này\n        </p>\n        $stats<!-- -->$topics\n        <table\n          role=\"presentation\"\n          width=\"100%\"\n          cellpadding=\"0\"\n          cellspacing=\"0\"\n          border=\"0\">\n          <tbody>\n            <tr>\n              <td align=\"center\">\n                <a\n                  href=\"$url\"\n                  class=\"box-border\"\n                  style=\"line-height:18px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;box-sizing:border-box;text-align:center;background-color:#EAF1EC;color:#176B5B;border:1px solid #D3DED5;border-radius:8px;padding:11px 26px;font-size:13px;font-weight:600;padding-top:11px;padding-right:26px;padding-bottom:11px;padding-left:26px\"\n                  target=\"_blank\"\n                  ><span\n                    ><!--[if mso]><i style=\"mso-font-width:433.3333333333333%;mso-text-raise:16.5px\" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span\n                  ><span\n                    style=\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:8.25px\"\n                    >Xem thêm phân tích cuộc họp</span\n                  ><span\n                    ><!--[if mso]><i style=\"mso-font-width:433.3333333333333%\" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span\n                  ></a\n                >\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </td>\n    </tr>\n  </tbody>\n</table>\n<!--/$$-->\n",
  "overview_item_titled": "<!--$$-->\n<li style=\"margin:0 0 10px;font-size:14px;line-height:22px;color:#173B36\">\n  <strong style=\"font-weight:700;color:#173B36\">$title:</strong>\n  <span style=\"color:#526860\">$text</span>\n</li>\n<!--/$$-->\n",
