{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tina:schemas/discussion-review.v1",
  "title": "discussion-review.v1",
  "$defs": {
    "EvidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 8, "uniqueItems": true },
    "Relevance": {
      "type": "object", "additionalProperties": false, "required": ["label", "reason", "source_ids"],
      "properties": {
        "label": { "enum": ["relevant", "useful_tangent", "off_scope", "uncertain"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 600 },
        "source_ids": { "$ref": "#/$defs/EvidenceIds" }
      }
    },
    "Interaction": {
      "type": "object", "additionalProperties": false, "required": ["labels", "reason", "source_ids"],
      "properties": {
        "labels": {
          "type": "array", "uniqueItems": true, "maxItems": 6,
          "items": { "enum": ["constructive_disagreement", "personal_hostility", "sarcasm", "dismissive_address", "threat", "uncertain"] }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 600 },
        "source_ids": { "$ref": "#/$defs/EvidenceIds" }
      }
    },
    "Progress": {
      "type": "object", "additionalProperties": false, "required": ["label", "reason", "source_ids"],
      "properties": {
        "label": { "enum": ["advancing", "exploring", "repeating_unresolved_positions", "uncertain"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 600 },
        "source_ids": { "$ref": "#/$defs/EvidenceIds" }
      }
    },
    "Window": {
      "type": "object", "additionalProperties": false, "required": ["id", "relevance", "interaction", "progress"],
      "properties": {
        "id": { "type": "string" },
        "relevance": { "$ref": "#/$defs/Relevance" },
        "interaction": { "$ref": "#/$defs/Interaction" },
        "progress": { "$ref": "#/$defs/Progress" }
      }
    },
    "Classification": {
      "type": "object", "additionalProperties": false, "required": ["windows"],
      "properties": { "windows": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/Window" } } }
    },
    "Source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "segment_id", "revision", "speaker_name", "start_ms", "end_ms", "quote", "audio_available"],
      "properties": {
        "id": { "type": "string" }, "segment_id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 }, "speaker_name": { "type": "string" },
        "start_ms": { "type": "number" }, "end_ms": { "type": "number" },
        "quote": { "type": "string", "minLength": 1 }, "audio_available": { "type": "boolean" }
      }
    },
    "Report": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "id", "meeting_id", "agenda", "canonical_revision", "source_revision", "rubric", "created_at", "model", "windows", "sources"],
      "properties": {
        "version": { "const": "discussion-review.v1" }, "id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "meeting_id": { "type": "integer", "minimum": 1 }, "agenda": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "canonical_revision": { "type": "integer", "minimum": 1 },
        "source_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rubric": { "const": "discussion.vi-en.v1" }, "created_at": { "type": "string", "format": "date-time" },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "windows": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/Window" } },
        "sources": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/Source" } }
      }
    }
  }
}
